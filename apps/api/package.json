{
  "name": "@ralph/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --conditions=source src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --conditions=source --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --conditions=source --env-file-if-exists=../../.env src/db/seed.ts",
    "check": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/check.ts",
    "tts:warm": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/warm-tts.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@google/genai": "^2.30.0",
    "@ralph/shared": "workspace:*",
    "fastify": "^5.2.0",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  }
}
