GEMINI_API_KEY=
GEMINI_MODEL=            # current fast Flash model — verify on https://ai.google.dev/gemini-api/docs/models
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
RALPH_VOICE=             # pick from Gemini TTS voice list
DATABASE_URL=            # Tiger Cloud connection string (sslmode=require)
PUBLIC_BASE_URL=http://localhost:5173  # set to the Vercel/custom domain URL in Vercel env settings
PORT=3001
CHECKIN_INTERVAL_SEC=120 # demo; 900 real
DEMO_MODE=true
SUPPORTED_LANGS=en,hi,es,fr,zh-CN
# Staff sign-in: badge:pin:Display Name entries separated by ';' (synthetic demo staff only).
STAFF_ACCOUNTS=1042:4821:Nurse Sam Lee;2077:3156:Dr. Ana Ortiz
# Signs staff session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
